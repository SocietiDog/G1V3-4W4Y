<Window x:Class="Gw2Giveaway.BankWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Gw2Giveaway"
        xmlns:conv="clr-namespace:Gw2Giveaway.Converters"
        Title="GW2 Prize Bank Editor" Height="500" Width="1050"
        AllowsTransparency="True"
Background="Transparent"
WindowStyle="None"
ResizeMode="CanResizeWithGrip"
WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="BankButton" TargetType="Button">
            <!-- Your existing style unchanged -->
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF3F3EA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFF3F3EA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        
       
    </Window.Resources>

    <Border CornerRadius="10" BorderThickness="4" Padding="20" BorderBrush="#FFEFDFDF" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Background>
            <ImageBrush ImageSource="/Images/2026-02-01-23.00-02-Gw2-64.png"/>
        </Border.Background>

        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Title bar buttons -->
                <RowDefinition Height="*"/>
                <!-- Slots grid -->
                <RowDefinition Height="Auto"/>
                <!-- Gold row -->
            </Grid.RowDefinitions>

            <!-- Title bar buttons (top-right) -->
            <StackPanel Orientation="Horizontal" Margin="0,10,10,0" HorizontalAlignment="Right" Grid.Row="0">
                <Button Content="−" Style="{StaticResource BankButton}" Click="MinimizeWindow_Click" FontSize="25" FontWeight="Bold" Width="45" Height="45" Margin="5" Padding="0,10,0,0" Foreground="#FFF3F3EA" />
                <Button Content="X" Style="{StaticResource BankButton}" Width="45" Height="45" Click="CloseApp_Click" Margin="5" Padding="0,0,0,0" FontSize="30" VerticalContentAlignment="Center" Foreground="#FFF3F3EA"/>
            </StackPanel>

            <!-- Slots grid -->
            <ItemsControl ItemsSource="{Binding Slots}" Grid.Row="1" Margin="25" BorderThickness="1" BorderBrush="#FFF3F3EA">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="3" Columns="10"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Viewbox Stretch="UniformToFill">
                            <Border Background="Transparent" Cursor="Hand" Margin="5"
                                    BorderBrush="{Binding IsHighlighted, Converter={StaticResource BoolToHighlightBrushConverter}}"
                                    BorderThickness="{Binding IsHighlighted, Converter={StaticResource BoolToThicknessConverter}}">
                                <Border.Effect>
                                    <DropShadowEffect Color="Gold"
                                                      BlurRadius="{Binding IsHighlighted, Converter={StaticResource BoolToBlurConverter}}"
                                                      ShadowDepth="0"
                                                      Opacity="0.9"/>
                                </Border.Effect>

                                <Border BorderThickness="4" BorderBrush="Transparent">
                                    <Grid>
                                        <!-- Tooltip -->
                                        <ToolTipService.ToolTip>
                                            <ToolTip Background="Black" Opacity="0.95" BorderBrush="Gold" BorderThickness="3" Padding="15" MaxWidth="450"
                                                     ToolTipService.IsEnabled="{Binding HasPrize}"
                                                     ToolTipService.ShowDuration="60000"
                                                     ToolTipService.InitialShowDelay="300"
                                                     ToolTipService.BetweenShowDelay="0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Source="{Binding ImageSource}" Width="128" Height="128" Stretch="UniformToFill" Margin="0,0,15,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ItemName}"
                                                                   FontSize="24"
                                                                   FontWeight="Bold"
                                                                   Foreground="{Binding Rarity, Converter={StaticResource RarityToBrushConverter}}"/>
                                                        <TextBlock Text="{Binding Rarity}"
                                                                   FontSize="18"
                                                                   Foreground="LightGray"
                                                                   Visibility="{Binding IsGw2Item, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                   Margin="0,5,0,0"/>
                                                        <TextBlock Text="{Binding Description}"
                                                                   FontSize="14"
                                                                   Foreground="#CCCCCC"
                                                                   TextWrapping="Wrap"
                                                                   Visibility="{Binding IsGw2Item, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                   Margin="0,10,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </ToolTip>
                                        </ToolTipService.ToolTip>

                                        <!-- Background/shading -->
                                        <Grid.Background>
                                            <SolidColorBrush Color="#FFEFDFDF" Opacity="0.15"/>
                                        </Grid.Background>
                                        <Rectangle>
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1" Opacity="0.1">
                                                    <GradientStop Color="Black" Offset="0"/>
                                                    <GradientStop Color="Transparent" Offset="0.5"/>
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>

                                        <!-- Main icon + stack text -->
                                        <Image Source="{Binding ImageSource}" Stretch="UniformToFill" Width="100" Height="100"/>
                                        <TextBlock Text="{Binding StackText}" Foreground="White" FontSize="20" FontWeight="Bold"
                                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5"/>

                                        <!-- NEW: Prize Rarity Badge (top-left) -->
                                        <Border Background="{Binding PrizeRarity, Converter={StaticResource PrizeRarityToBrushConverter}}"
                                            CornerRadius="10"
                                            Padding="10,6"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="12"
                                            Opacity="0.9"
                                            Visibility="{Binding ShowPrizeRarityBadges, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                        <TextBlock Text="{Binding PrizeRarity, Converter={StaticResource PrizeRarityToTextConverter}}"
                                                   Foreground="Black"
                                                   FontWeight="Bold"
                                                   FontSize="18"/>  
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Left click -->
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding EditCommand}"/>
                                </Border.InputBindings>

                                <!-- Right click context menu with Prize Rarity submenu -->
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Select GW2 Item" Command="{Binding EditCommand}"/>
                                        <MenuItem Header="Set Custom Prize" Command="{Binding CustomPrizeCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="Set Display Stack Size"
                                                  Command="{Binding SetDisplayStackCommand}"
                                                  IsEnabled="{Binding HasPrize}"/>
                                        <MenuItem Header="Set Giveaway Amount"
                                                  Command="{Binding SetGiveawayAmountCommand}"
                                                  IsEnabled="{Binding HasPrize}"/>
                                        <Separator/>
                                        <!-- Prize Rarity submenu -->
                                        <MenuItem Header="Prize Rarity">
                                            <MenuItem Header="Common"
                                                      Command="{Binding SetPrizeRarityCommand}"
                                                      CommandParameter="{x:Static local:PrizeRarity.Common}"/>
                                            <MenuItem Header="Uncommon"
                                                      Command="{Binding SetPrizeRarityCommand}"
                                                      CommandParameter="{x:Static local:PrizeRarity.Uncommon}"/>
                                            <MenuItem Header="Rare"
                                                      Command="{Binding SetPrizeRarityCommand}"
                                                      CommandParameter="{x:Static local:PrizeRarity.Rare}"/>
                                            <MenuItem Header="Super Rare"
                                                      Command="{Binding SetPrizeRarityCommand}"
                                                      CommandParameter="{x:Static local:PrizeRarity.SuperRare}"/>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="Clear Slot"
                                                  Command="{Binding ClearCommand}"
                                                  IsEnabled="{Binding HasPrize}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                            </Border>
                        </Viewbox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Gold Row -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,25,20">

                <TextBlock x:Name="GoldText" Text="{Binding GoldAmount, StringFormat='{}{0}'}" FontSize="25
               " Foreground="Gold" FontWeight="Bold"
               Margin="30,0,5,0" Cursor="Hand" MouseDown="GoldText_MouseDown"/>
                <Image Source="/Images/Gold_coin.png" Width="35" Stretch="Uniform"/>
            </StackPanel>

            <!-- Winner Grid (for roll animation) -->
            <Grid x:Name="WinnerGrid" Grid.RowSpan="3" Visibility="Collapsed" Background="#AA000000">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" Margin="0,10,10,0" HorizontalAlignment="Right"  >

                        <Button Content="−" Style="{StaticResource BankButton}" Click="MinimizeWindow_Click" FontSize="25" FontWeight="Bold" Width="45" Height="45" Margin="5,5,5,5" Padding="0,10,0,0" Foreground="#FFF3F3EA" />

                        <Button Content="X" Style="{StaticResource BankButton}" Width="45" Height="45" Click="CloseApp_Click" Margin="5" Padding="0,0,0,0" FontSize="30" VerticalContentAlignment="Center" Foreground="#FFF3F3EA"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                        <TextBlock Text="WINNER!" FontSize="30" Foreground="Gold" FontWeight="Bold" Margin="0,0,0,40"/>
                        <TextBlock x:Name="WinnerNameText" FontSize="30" Foreground="White" FontWeight="Bold" Margin="0,0,0,50"/>
                        <Image x:Name="WinnerPrizeImage" Width="80" Height="80" Stretch="Uniform" Margin="0,0,0,40"/>
                        <TextBlock x:Name="WinnerPrizeText" FontSize="30" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>