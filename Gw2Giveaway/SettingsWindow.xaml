<Window x:Class="Gw2Giveaway.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Gw2Giveaway.Converters"
        xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
        Title="Trivia-Tron Settings" Height="810" Width="550"     AllowsTransparency="True" Background="Transparent" WindowStyle="None" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="BankButton" TargetType="Button">
            <!-- Same as BankWindow -->
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFF3F3EA"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            CornerRadius="16"
                            Padding="{TemplateBinding Padding}"
                            BorderBrush="#40FFFFFF"
                            BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF3F3EA"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#DDD3C3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF3F3EA"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#AA000000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFEFDFDF"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#AA000000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFEFDFDF"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFF3F3EA"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20" BorderThickness="4" BorderBrush="#FFEFDFDF" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Background>
            <ImageBrush ImageSource="/Images/2026-02-01-23.00-02-Gw2-64.png" Stretch="Fill"/>
        </Border.Background>
        <StackPanel Margin="30">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Overlay Color Customization" FontSize="22" FontWeight="Bold" Margin="0,0,78,0"/>
                <Button Content="−" Style="{StaticResource BankButton}" Click="MinimizeWindow_Click" FontSize="25" FontWeight="Bold" Width="45" Height="45" Margin="5" Padding="0,10,0,0" Foreground="#FFF3F3EA"/>
                <Button Content="X" Style="{StaticResource BankButton}" Click="Close_Click" Width="45" Height="45" Margin="5" Padding="0,0,0,0" FontSize="30" VerticalContentAlignment="Center" Foreground="#FFF3F3EA"/>
            </StackPanel>


            <!-- Overlay Color Customization Section -->
            
            
            <TextBlock Text="Click the color swatch to open the full picker. Changes apply LIVE and save automatically!"
                       TextWrapping="Wrap" Margin="0,0,0,5" Foreground="#666666" FontStyle="Italic"/>

            <!-- Background (alpha enabled) -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="Background:" Width="180" VerticalAlignment="Center"/>
                <colorpicker:PortableColorPicker  x:Name="BackgroundPicker"
                    SelectedColor="{Binding OverlayBackground, Converter={StaticResource ColorToHexConverter}, Mode=OneWay}"
                    ColorChanged="ColorPicker_ColorChanged"
                    Tag="OverlayBackground"
                    ShowAlpha="True"
                    Width="100"
                    Height="40"
                    VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Inner Background (alpha enabled) -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="Inner Background (question):" Width="180" VerticalAlignment="Center"/>
                <colorpicker:PortableColorPicker  x:Name="InnerBackgroundPicker"
                    SelectedColor="{Binding OverlayInnerBackground, Converter={StaticResource ColorToHexConverter}, Mode=OneWay}"
                    ColorChanged="ColorPicker_ColorChanged"
                    Tag="OverlayInnerBackground"
                    ShowAlpha="True"
                    Width="100"
                    Height="40"
                    VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Border Color -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="Border Color:" Width="180" VerticalAlignment="Center"/>
                <colorpicker:PortableColorPicker x:Name="BorderColorPicker"
                    SelectedColor="{Binding OverlayBorderColor, Converter={StaticResource ColorToHexConverter}, Mode=OneWay}"
                    ColorChanged="ColorPicker_ColorChanged"
                    Tag="OverlayBorderColor"
                    ShowAlpha="False"
                    Width="100"
                    Height="40"
                    VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Title Color -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="Title Color:" Width="180" VerticalAlignment="Center"/>
                <colorpicker:PortableColorPicker x:Name="TitleColorPicker"
                    SelectedColor="{Binding TitleColor, Converter={StaticResource ColorToHexConverter}, Mode=OneWay}"
                    ColorChanged="ColorPicker_ColorChanged"
                    Tag="TitleColor"
                    ShowAlpha="False"
                    Width="100"
                    Height="40"
                    VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Header Color -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="Header Color:" Width="180" VerticalAlignment="Center"/>
                <colorpicker:PortableColorPicker x:Name="HeaderColorPicker"
                    SelectedColor="{Binding HeaderColor, Converter={StaticResource ColorToHexConverter}, Mode=OneWay}"
                    ColorChanged="ColorPicker_ColorChanged"
                    Tag="HeaderColor"
                    ShowAlpha="False"
                    Width="100"
                    Height="40"
                    VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Text Color -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="Text Color:" Width="180" VerticalAlignment="Center"/>
                <colorpicker:PortableColorPicker x:Name="TextColorPicker"
                    SelectedColor="{Binding TextColor, Converter={StaticResource ColorToHexConverter}, Mode=OneWay}"
                    ColorChanged="ColorPicker_ColorChanged"
                    Tag="TextColor"
                    ShowAlpha="False"
                    Width="100"
                    Height="40"
                    VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Accent Color -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="Accent Color (commands):" Width="180" VerticalAlignment="Center"/>
                <colorpicker:PortableColorPicker x:Name="AccentColorPicker"
                    SelectedColor="{Binding AccentColor, Converter={StaticResource ColorToHexConverter}, Mode=OneWay}"
                    ColorChanged="ColorPicker_ColorChanged"
                    Tag="AccentColor"
                    ShowAlpha="False"
                    Width="100"
                    Height="40"
                    VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Gold Color -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="Gold Color:" Width="180" VerticalAlignment="Center"/>
                <colorpicker:PortableColorPicker  x:Name="GoldColorPicker"
                    SelectedColor="{Binding GoldColor, Converter={StaticResource ColorToHexConverter}, Mode=OneWay}"
                    ColorChanged="ColorPicker_ColorChanged"
                    Tag="GoldColor"
                    ShowAlpha="False"
                    Width="100"
                    Height="40"
                    VerticalAlignment="Center"/>
            </StackPanel>
            
            <CheckBox Content="Auto-open Overlay on startup"
          IsChecked="{Binding AutoOpenOverlay}"
          HorizontalAlignment="Left"
          Margin="0,0,0,5"/>
            <TextBlock Text="Trivia Rewards" FontSize="22" FontWeight="Bold" Margin="0,5,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="First correct:" Width="180" VerticalAlignment="Center"/>
                <TextBox Text="{Binding FirstCorrectReward, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                <TextBlock Text=" IQ" VerticalAlignment="Center" Margin="10,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="Later correct:" Width="180" VerticalAlignment="Center"/>
                <TextBox Text="{Binding LaterCorrectReward, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                <TextBlock Text=" IQ" VerticalAlignment="Center" Margin="10,0"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Margin="25,5,30,5">
                <Button Content="Reset Colors to Defaults" Style="{StaticResource BankButton}" Click="ResetColors_Click" Padding="15,8" Margin="0,0,50,0" Height="40"/>
                <Button Content="Save and Close" Style="{StaticResource BankButton}" Click="SaveButton_Click" Padding="15,8" Height="40"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>