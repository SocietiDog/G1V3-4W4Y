<Window x:Class="Gw2Giveaway.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Gw2Giveaway"
        Title="GW2 Giveaway Tool" Height="900" Width="600
        
        "
        AllowsTransparency="True" Background="Transparent" WindowStyle="None" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="BankButton" TargetType="Button">
            <!-- Same as BankWindow -->
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFF3F3EA"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF3F3EA"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#DDD3C3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF3F3EA"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#AA000000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFEFDFDF"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#AA000000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFEFDFDF"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFF3F3EA"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20" BorderThickness="4" BorderBrush="#FFEFDFDF" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Background>
            <ImageBrush ImageSource="/Images/2026-02-01-23.00-02-Gw2-64.png" Stretch="Fill"/>
        </Border.Background>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="−" Style="{StaticResource BankButton}" Click="MinimizeWindow_Click" FontSize="25" FontWeight="Bold" Width="45" Height="45" Margin="5" Padding="0,10,0,0" Foreground="#FFF3F3EA"/>
                <Button Content="X" Style="{StaticResource BankButton}" Click="Close_Click" Width="45" Height="45" Margin="5" Padding="0,0,0,0" FontSize="30" VerticalContentAlignment="Center" Foreground="#FFF3F3EA"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,36,0,84" Grid.RowSpan="2">
                <StackPanel>
                    <!-- Database -->
                    <TextBlock Text="Database Status" FontSize="20" FontWeight="Bold" Foreground="Gold" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <ProgressBar x:Name="DatabaseProgress" 
                 Width="215" 
                 Height="30" 
                 Value="0" 
                 Maximum="100"
                 Margin="0,0,20,0">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Foreground" Value="Gold"/>
                                    <Setter Property="Background" Value="#66000000"/>
                                    <Setter Property="BorderBrush" Value="#FFEFDFDF"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ProgressBar">
                                                <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="15">
                                                    <Grid>
                                                        <Rectangle x:Name="PART_Indicator"
                                               HorizontalAlignment="Left"
                                               Fill="{TemplateBinding Foreground}"
                                               RadiusX="15" RadiusY="15"/>
                                                        <Rectangle x:Name="PART_Track"/>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>

                        <TextBlock x:Name="DatabaseStatus" 
               Text="Loading..." 
               FontSize="18"
               Foreground="#FFF3F3EA"
               VerticalAlignment="Center"
               Margin="0,0,20,0"/>

                    </StackPanel >
                    <StackPanel>
                        <Button Content="Refresh Database" 
Click="RefreshDatabase_Click" 
Style="{StaticResource BankButton}"
Width="120"
Height="27"
FontSize="12" Padding="0,0,0,0" HorizontalAlignment="Left" Margin="8,0,8,8"/>
                    </StackPanel>
                    <!-- Twitch Connection -->
                    <TextBlock Text="Twitch Connection" FontSize="20" FontWeight="Bold" Foreground="Gold" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,20" Width="420" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Channel:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="ChannelText" Margin="5,5,0,5"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Bot Name:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="BotNameText" Margin="5,5,0,5"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="OAuth:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="OAuthBox" Margin="5,0,0,60" Grid.RowSpan="2"/>
                        <Button Grid.Row="3" Grid.Column="1" Content="Connect to Twitch" Click="Connect_Click" Style="{StaticResource BankButton}" HorizontalAlignment="Left" Padding="5,5,5,5" FontSize="12" Margin="8,8,0,22"/>
                        <TextBlock x:Name="TwitchStatus" Grid.Row="3" Grid.Column="1"  Text="Not connected" Foreground="Red" FontWeight="Bold" Margin="0,10,25,0" RenderTransformOrigin="0.81,1.698" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Entry Settings -->
                    <TextBlock Text="Entry Settings" FontSize="20" FontWeight="Bold" Foreground="Gold" Margin="0,0,0,10"/>
                    <StackPanel Margin="0,0,0,20">
                        <ComboBox x:Name="EntryModeCombo" SelectedIndex="0" Width="168" HorizontalAlignment="Left" Background="#AA2B0404" Foreground="#FF0A0A0A">
                            <ComboBoxItem>!Command</ComboBoxItem>
                            <ComboBoxItem>All Chatters</ComboBoxItem>
                            <ComboBoxItem>Channel Point (Manual)</ComboBoxItem>
                        </ComboBox>
                        <TextBox x:Name="EntryCommandText" Margin="5,5,0,0" ToolTip="Command text (e.g. !enter)" Width="173" HorizontalAlignment="Left"/>
                        <TextBlock Text="For Channel Point: use Manual Add button below (real detection coming soon)" FontSize="12" Foreground="Gray" Margin="0,5,0,0"/>
                        <Button Content="Manual Add Entry" Click="ManualAddEntry_Click" Style="{StaticResource BankButton}" Margin="0,10,0,0" Width="182" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Padding="20,5,20,5" FontSize="12"/>
                    </StackPanel>

                    <!-- Message Templates -->
                    <TextBlock Text="Custom Messages" FontSize="20" FontWeight="Bold" Foreground="Gold" Margin="0,0,0,10"/>
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Chat Announcement Template (use {winner}, {prize}, {amount})"/>
                        <TextBox x:Name="ChatTemplateText" Height="60" AcceptsReturn="True" TextWrapping="Wrap" Width="400" HorizontalAlignment="Left"/>
                        <TextBlock Text="Winner Screen Prize Text Template (use {amount}, {prize})" Margin="0,10,0,0"/>
                        <TextBox x:Name="WinnerPrizeTemplateText" Width="400" HorizontalAlignment="Left" />
                    </StackPanel>

                    <!-- Roll Settings -->
                    <TextBlock Text="Roll Settings" FontSize="20" FontWeight="Bold" Foreground="Gold" Margin="0,0,0,10" Width="202" HorizontalAlignment="Left"/>
                    <StackPanel Margin="0,0,0,20">
                        <ComboBox x:Name="RollModeCombo" SelectedIndex="0" Foreground="Black" Width="220" HorizontalAlignment="Left">
                            <ComboBoxItem>Classic Wheel</ComboBoxItem>
                            <ComboBoxItem>Bank Animation</ComboBoxItem>
                            <ComboBoxItem>Bank Random (No Animation)</ComboBoxItem>
                        </ComboBox>
                        <CheckBox x:Name="ShowRarityBadgesCheck" Content="Show Prize Rarity Badges in Bank Editor" IsChecked="True"/>
                    </StackPanel>

                    <!-- Classic Prize Setup (for Wheel mode) -->
                    <TextBlock Text="Classic Prize Setup (used for Wheel mode)" FontSize="20" FontWeight="Bold" Foreground="Gold" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Prize Name:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="ClassicPrizeNameText"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="GW2 Item ID or Image URL:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="ClassicPrizeInputText" Width="200"/>
                            <Button Content="Fetch/Load" Click="ClassicPrizeFetch_Click" Style="{StaticResource BankButton}"/>
                        </StackPanel>
                        <Button Grid.Row="2" Grid.Column="1" Content="Search GW2 Item" Click="SelectClassicPrizeItem_Click" Style="{StaticResource BankButton}" HorizontalAlignment="Left"/>
                    </Grid>
                    <Image x:Name="ClassicPrizePreview" Height="200" Stretch="Uniform" Margin="0,10,0,20"/>

                    <!-- Bank -->
                    <Button Content="Open Prize Bank Editor" Click="OpenPrizeBank_Click" Style="{StaticResource BankButton}" Width="300" Height="50" FontSize="20"/>

                    <!-- Entrants -->
                    <TextBlock Text="Current Entrants" FontSize="20" FontWeight="Bold" Foreground="Gold" Margin="0,20,0,10"/>
                    <ListBox x:Name="EntrantsList" Height="200" Background="#AA000000" Foreground="White" BorderBrush="#FFEFDFDF"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,20">
                <Button Content="Show Overlay" Click="ShowOverlay_Click" Style="{StaticResource BankButton}" Width="115" Height="37" FontSize="14" Margin="10" Padding="5,6,5,6"/>
                <Button Content="ROLL WINNER" Click="StartRoll_Click" Style="{StaticResource BankButton}" Width="148" Height="44" FontSize="16" FontWeight="ExtraBold" Margin="10" Padding="5,6,5,6"/>
                <Button Content="Clear Entrants" Click="ClearEntrants_Click" Style="{StaticResource BankButton}" Width="121" Height="40" FontSize="14" Margin="10" Padding="5,6,5,6"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>