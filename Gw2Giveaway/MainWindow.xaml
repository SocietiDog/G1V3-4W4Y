<Window x:Class="Gw2Giveaway.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Gw2Giveaway"
        mc:Ignorable="d"
        Title="GW2 Giveaway Tool" Height="800" Width="700">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                <ProgressBar x:Name="DatabaseProgress" Width="400" Height="20" Value="0" Maximum="100"/>
                <TextBlock x:Name="DatabaseStatus" Text="Database: Checking cache..." Margin="10,0" VerticalAlignment="Center"/>
                <Button Content="Refresh Database" Click="RefreshDatabase_Click" Margin="10,0" Padding="10,5"/>
            </StackPanel>
            <TextBlock Text="Twitch Connection" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Channel:" Margin="0,0,10,5" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="ChannelText" Text="yourchannel" Margin="0,0,0,5"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Bot Name:" Margin="0,0,10,5" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="BotNameText" Text="yourbot" Margin="0,0,0,5"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="OAuth:" Margin="0,0,10,5" VerticalAlignment="Center"/>
                <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="OAuthBox" Margin="0,0,0,5"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Entry Command:" Margin="0,0,10,5" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="EntryCommandText" Text="!enter" Margin="0,0,0,5"/>

                <Button Grid.Row="4" Grid.Column="1" Content="Connect" Click="Connect_Click" HorizontalAlignment="Left" Padding="10,5"/>
            </Grid>

            <TextBlock Text="Prize Setup" FontSize="16" FontWeight="Bold" Margin="0,20,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Prize Name:" Margin="0,0,10,5" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="PrizeNameText" Text="Legendary Weapon" Margin="0,0,0,5"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="GW2 Item ID:" Margin="0,0,10,5" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="ItemIdText" Width="150" Margin="0,0,5,0"/>
                    <Button Content="Fetch Item" Click="FetchItem_Click"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Or Image URL:" Margin="0,0,10,5" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="ImageUrlText" Margin="0,0,0,5"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Quick Select:" Margin="0,0,10,5" VerticalAlignment="Center"/>
                <Button Grid.Row="3" Grid.Column="1" Content="Search Item from Database" Click="SelectClassicPrizeItem_Click" Margin="0,0,0,5" Padding="10,5"/>
            </Grid>

            <Image x:Name="PrizePreview" Height="200" Margin="0,10" Stretch="Uniform"/>
        </StackPanel>

        <ListBox Grid.Row="1" x:Name="EntrantsList" Margin="0,10"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Show Overlay" Click="ShowOverlay_Click" Margin="5" Padding="10,5"/>
            <Button Content="Start Roll" Click="StartRoll_Click" Margin="5" Padding="10,5"/>
            <Button Content="Clear Entrants" Click="ClearEntrants_Click" Margin="5" Padding="10,5"/>
            
            <Button Content="Open Prize Bank" Click="OpenPrizeBank_Click" Margin="5" Padding="10,5"/>
            <Button Content="Test Prize Roll" Click="TestPrizeRoll_Click" Margin="5" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>