<Window x:Class="Gw2Giveaway.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GW2 Giveaway Overlay" Width="600" Height="600"
        AllowsTransparency="True" Background="Transparent" WindowStyle="None"
        ResizeMode="CanResizeWithGrip" Topmost="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Same button style as BankWindow/MainWindow -->
        <Style x:Key="OverlayCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFF3F3EA"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#AAFF0000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text styles for readability on stream -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" ShadowDepth="3" BlurRadius="8" Opacity="0.8"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="30" BorderThickness="6" BorderBrush="#FFEFDFDF" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Background>
            <ImageBrush ImageSource="/Images/2026-02-01-23.00-02-Gw2-64.png" Opacity="0.6" Stretch="Fill"/>
        </Border.Background>

        <!-- Dark overlay for better text readability (added back) -->
        
        <Grid>
            <!-- Small close button (top-right – subtle red on hover) -->
            <Button Content="X" Style="{StaticResource OverlayCloseButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Click="Close_Click" Width="60" Height="60"/>

            <!-- Prize Mode -->
            <Grid x:Name="PrizeGrid" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Giveaway Active!" FontSize="40" Foreground="Gold" Margin="0,0,0,40"/>
                    <TextBlock x:Name="PrizeTitleText" FontSize="36" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,50"/>
                    <Image x:Name="PrizeImage" Width="200" Height="200" Stretch="Uniform" Margin="0,0,0,50"/>
                    <TextBlock x:Name="EntryInstructionText"
                               Text="Type !enter in chat to join"
                               FontSize="32"
                               Foreground="White"/>
                </StackPanel>
            </Grid>
            <!-- Slot Machine Mode – single big vertical reel, centered, no top arrow, middle highlight -->
            <!-- SlotGrid – updated for better box sizing and centering -->
            <Grid x:Name="SlotGrid" Visibility="Collapsed" Background="Transparent">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#CC000000" CornerRadius="40" BorderBrush="Gold" BorderThickness="10" Width="420" Height="620">
                        <Grid>
                            <Canvas ClipToBounds="True">
                                <StackPanel x:Name="SlotReelContent">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform/>
                                    </StackPanel.RenderTransform>
                                </StackPanel>
                            </Canvas>

                            <!-- Winner highlight – bigger, perfect middle framing -->
                            <Border x:Name="SlotWinnerHighlight"
                        BorderBrush="Gold"
                        BorderThickness="16"
                        CornerRadius="50"
                        Opacity="0"
                        VerticalAlignment="Center"
                        Height="160"
                        IsHitTestVisible="False">
                                <Border.Background>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#AAFFD700" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="Gold" BlurRadius="50" ShadowDepth="0" Opacity="1"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <!-- New Scramble Mode (replace WheelGrid) -->
            <Grid x:Name="ScrambleGrid" Visibility="Collapsed" Background="Transparent">
                <ItemsControl x:Name="ScrambleItems" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" Rows="6"/>
                            <!-- Adjust grid for your window size -->
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#AA000000" CornerRadius="15" Padding="20" Margin="10" Opacity="0.8">
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard x:Name="FlashStoryboard">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.5" To="1" Duration="0:0:0.1" AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <TextBlock Text="{Binding}" FontSize="24" Foreground="White" FontWeight="Bold" TextAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <StackPanel x:Name="WheelGrid" Visibility="Collapsed">
                <Viewbox Stretch="Uniform">
                    <Canvas Width="400" Height="400">
                        <Polygon Points="180,40 200,0 220,40" Fill="Gold" Stroke="Black" StrokeThickness="6"/>
                        <Canvas x:Name="RotatableCanvas" Width="400" Height="400">
                            <Canvas.RenderTransform>
                                <RotateTransform x:Name="WheelRotate" CenterX="200" CenterY="200"/>
                            </Canvas.RenderTransform>
                        </Canvas>
                    </Canvas>
                </Viewbox>
            </StackPanel>

            <!-- Winner Mode – balanced sizes -->
            <Grid x:Name="WinnerGrid" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="WINNER!" FontSize="60" Foreground="Gold" Margin="0,0,0,50"/>
                    <TextBlock x:Name="WinnerNameText" FontSize="50" Foreground="White" Margin="0,0,0,60"/>
                    <Image x:Name="WinnerPrizeImage" Width="200" Height="200" Stretch="Uniform" Margin="0,0,0,60"/>
                    <TextBlock x:Name="WinnerPrizeText" FontSize="40" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>