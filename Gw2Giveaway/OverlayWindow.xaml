<Window x:Class="Gw2Giveaway.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GW2 Giveaway Overlay" Width="1600" Height="900"
        AllowsTransparency="True" Background="Transparent" WindowStyle="None"
        ResizeMode="CanResizeWithGrip" Topmost="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Same button style as BankWindow/MainWindow -->
        <Style x:Key="OverlayCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFF3F3EA"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#AAFF0000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text styles for readability on stream -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" ShadowDepth="3" BlurRadius="8" Opacity="0.8"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="30" BorderThickness="6" BorderBrush="#FFEFDFDF" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Background>
            <ImageBrush ImageSource="/Images/2026-02-01-23.00-02-Gw2-64.png" Opacity="0.6" Stretch="Fill"/>
        </Border.Background>

        <!-- Dark overlay for better text readability -->
        

        <Grid>
            <!-- Small close button (top-right – subtle red on hover) -->
            <Button Content="X" Style="{StaticResource OverlayCloseButton}" 
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Click="Close_Click" Width="60" Height="60"/>

            <!-- Prize Mode -->
            <Grid x:Name="PrizeGrid" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Giveaway Active!" FontSize="80" Foreground="Gold" Margin="0,0,0,60"/>
                    <TextBlock x:Name="PrizeTitleText" FontSize="100" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,80"/>
                    <Image x:Name="PrizeImage" Width="600" Height="600" Stretch="Uniform" Margin="0,0,0,80"/>
                    <TextBlock Text="Type !enter in chat to join" FontSize="70" Foreground="White"/>
                </StackPanel>
            </Grid>

            <!-- Wheel Mode -->
            <Canvas x:Name="WheelGrid" Visibility="Collapsed">
                <Canvas Width="1000" Height="1000" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Fixed golden arrow (bigger and nicer) -->
                    <Polygon Points="480,80 500,10 520,80" Fill="Gold" Stroke="Black" StrokeThickness="8"/>
                    <!-- Rotatable wheel -->
                    <Canvas x:Name="RotatableCanvas" Width="1000" Height="1000">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="WheelRotate" CenterX="500" CenterY="500"/>
                        </Canvas.RenderTransform>
                    </Canvas>
                </Canvas>
            </Canvas>

            <!-- Winner Mode -->
            <Grid x:Name="WinnerGrid" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="WINNER!" FontSize="180" Foreground="Gold" Margin="0,0,0,100"/>
                    <TextBlock x:Name="WinnerNameText" FontSize="160" Foreground="White" Margin="0,0,0,120"/>
                    <Image x:Name="WinnerPrizeImage" Width="600" Height="600" Stretch="Uniform" Margin="0,0,0,100"/>
                    <TextBlock x:Name="WinnerPrizeText" FontSize="120" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>