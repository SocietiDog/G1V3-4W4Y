<Window x:Class="Gw2Giveaway.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Gw2Giveaway"
        mc:Ignorable="d"
        Background="LimeGreen" WindowStyle="None" AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip" Topmost="True" Width="1200" Height="800">

    <Grid>
        <!-- Prize Mode -->
        <Grid x:Name="PrizeGrid">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Giveaway Active!" FontSize="50" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock x:Name="PrizeTitleText" FontSize="60" Foreground="White" TextWrapping="Wrap" TextAlignment="Center"/>
                <Image x:Name="PrizeImage" Width="500" Stretch="Uniform" Margin="20"/>
                <TextBlock Text="Type !enter in chat to join" FontSize="40" Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Wheel Mode -->
        <Canvas x:Name="WheelGrid" Visibility="Collapsed" Background="Transparent">
            <Canvas Width="800" Height="800" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Fixed arrow -->
                <Polygon Points="380,60 400,10 420,60" Fill="Yellow" Stroke="Black" StrokeThickness="5"/>

                <!-- Rotatable wheel content -->
                <Canvas x:Name="RotatableCanvas" Width="800" Height="800">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="WheelRotate" CenterX="400" CenterY="400"/>
                    </Canvas.RenderTransform>
                </Canvas>
            </Canvas>
        </Canvas>

        <!-- Winner Mode -->
        <Grid x:Name="WinnerGrid" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="WINNER!" FontSize="80" Foreground="Gold" FontWeight="Bold"/>
                <TextBlock x:Name="WinnerNameText" FontSize="100" Foreground="White" FontWeight="Bold" Margin="0,20"/>
                <Image x:Name="WinnerPrizeImage" Width="400" Stretch="Uniform" Margin="20"/>
                <TextBlock x:Name="WinnerPrizeText" FontSize="50" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
