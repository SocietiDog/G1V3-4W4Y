<Window x:Class="Gw2Giveaway.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="G1V3 - 4W4Y Overlay" Width="600" Height="750"
        AllowsTransparency="True" Background="Transparent" WindowStyle="None"
        ResizeMode="CanResizeWithGrip" Topmost="True"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <!-- Close button style -->
        <Style x:Key="OverlayCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFF3F3EA"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#AAFF0000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text styles for readability on stream -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" ShadowDepth="3" BlurRadius="8" Opacity="0.8"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="30" BorderThickness="6" BorderBrush="#FFEFDFDF" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Background>
            <ImageBrush ImageSource="/Images/2026-02-01-23.00-02-Gw2-64.png" Opacity="0.6" Stretch="Fill"/>
        </Border.Background>

        <Grid>
            <!-- Close button -->
            <Button Content="X" Style="{StaticResource OverlayCloseButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Click="Close_Click" Width="60" Height="60"/>

            <!-- Prize Mode -->
            <Grid x:Name="PrizeGrid" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Giveaway Active!" FontSize="40" Foreground="Gold" Margin="0,0,0,40"/>
                    <TextBlock x:Name="PrizeTitleText" FontSize="36" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,50"/>
                    <Image x:Name="PrizeImage" Width="200" Height="200" Stretch="Uniform" Margin="0,0,0,50"/>
                    <TextBlock x:Name="EntryInstructionText"
                               Text="Type !enter in chat to join"
                               FontSize="32"
                               Foreground="White"/>
                </StackPanel>
            </Grid>

            <!-- Slot Machine Mode – Enhanced with colors -->
            <Grid x:Name="SlotGrid" Visibility="Collapsed" Background="Transparent">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#CC000000" CornerRadius="40" BorderBrush="Gold" 
                            BorderThickness="12" Width="520" Height="650" Padding="15">
                        <Border.Effect>
                            <DropShadowEffect Color="Gold" ShadowDepth="0" BlurRadius="30" Opacity="0.8"/>
                        </Border.Effect>

                        <Grid>
                            <!-- Scrolling reel with clip -->
                            <Canvas ClipToBounds="True" Width="470" Height="600">
                                <StackPanel x:Name="SlotReelContent" Orientation="Vertical">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform/>
                                    </StackPanel.RenderTransform>
                                </StackPanel>
                            </Canvas>

                            <!-- Top/bottom gradient fade -->
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF000000" Offset="0"/>
                                        <GradientStop Color="#00000000" Offset="0.3"/>
                                        <GradientStop Color="#00000000" Offset="0.7"/>
                                        <GradientStop Color="#FF000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <!-- Winner highlight (center frame) -->
                            <Border x:Name="SlotWinnerHighlight"
                                    BorderBrush="Gold" BorderThickness="18"
                                    CornerRadius="50" Opacity="0"
                                    VerticalAlignment="Center" Height="180" Width="460">
                                <Border.Effect>
                                    <DropShadowEffect Color="Gold" ShadowDepth="0" BlurRadius="30" Opacity="0.8"/>
                                </Border.Effect>
                            </Border>

                            <!-- Separator lines -->
                            <Line X1="0" Y1="310" X2="470" Y2="310" Stroke="Gold" StrokeThickness="3" Opacity="0.3"/>
                            <Line X1="0" Y1="490" X2="470" Y2="490" Stroke="Gold" StrokeThickness="3" Opacity="0.3"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Scramble Mode -->
            <Grid x:Name="ScrambleGrid" Visibility="Collapsed" Background="Transparent">
                <ItemsControl x:Name="ScrambleItems" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" Rows="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#AA000000" CornerRadius="15" Padding="20" Margin="10" Opacity="0.8">
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard x:Name="FlashStoryboard">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.5" To="1" Duration="0:0:0.1" AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <TextBlock Text="{Binding}" FontSize="24" Foreground="White" FontWeight="Bold" TextAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Wheel Mode -->
            <StackPanel x:Name="WheelGrid" Visibility="Collapsed">
                <Viewbox Stretch="Uniform">
                    <Canvas Width="400" Height="400">
                        <Polygon Points="180,40 200,0 220,40" Fill="Gold" Stroke="Black" StrokeThickness="6"/>
                        <Canvas x:Name="RotatableCanvas" Width="400" Height="400">
                            <Canvas.RenderTransform>
                                <RotateTransform x:Name="WheelRotate" CenterX="200" CenterY="200"/>
                            </Canvas.RenderTransform>
                        </Canvas>
                    </Canvas>
                </Viewbox>
            </StackPanel>

            <!-- Winner Mode -->
            <Grid x:Name="WinnerGrid" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="WINNER!" FontSize="60" Foreground="Gold" Margin="0,0,0,50"/>
                    <TextBlock x:Name="WinnerNameText" FontSize="50" Foreground="White" Margin="0,0,0,60"/>

                    <!-- Prize Pool Selection Display (2 boxes - Bank vs Displayed Prize) - only shown in RandomPool mode -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,50" x:Name="PrizePoolPanel" Visibility="Collapsed">
                        <!-- Bank Option -->
                        <Border x:Name="BankPoolBox" Background="#AA1a1a2e" CornerRadius="20" 
                                Padding="20" Margin="0,0,30,0" BorderBrush="#333366" BorderThickness="3"
                                Width="160" Height="160">
                            <Border.Effect>
                                <DropShadowEffect x:Name="BankPoolGlow" Color="Blue" ShadowDepth="0" BlurRadius="5" Opacity="0"/>
                            </Border.Effect>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🏦" FontSize="50" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="BANK" FontSize="18" Foreground="#6699FF" HorizontalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <!-- Displayed Prize Option -->
                        <Border x:Name="DisplayedPoolBox" Background="#AA1a1a2e" CornerRadius="20"
                                Padding="20" Margin="30,0,0,0" BorderBrush="#666633" BorderThickness="3"
                                Width="160" Height="160">
                            <Border.Effect>
                                <DropShadowEffect x:Name="DisplayedPoolGlow" Color="Gold" ShadowDepth="0" BlurRadius="5" Opacity="0"/>
                            </Border.Effect>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="⭐" FontSize="50" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="PRIZE" FontSize="18" Foreground="#FFDD00" HorizontalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Image x:Name="WinnerPrizeImage" Width="200" Height="200" Stretch="Uniform" Margin="0,0,0,60"/>
                    <TextBlock x:Name="WinnerPrizeText" FontSize="40" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>