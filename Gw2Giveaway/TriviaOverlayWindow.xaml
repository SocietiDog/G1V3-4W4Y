<Window x:Class="Gw2Giveaway.TriviaOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Gw2Giveaway"
                xmlns:converters="clr-namespace:Gw2Giveaway.Converters"
        Title="G1V3 - 4W4Y Trivia-Tron" Height="580" Width="500"
        MinWidth="350" MinHeight="450"
        WindowStyle="None" AllowsTransparency="True" Background="#01000000"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="Manual" >
    <Window.Resources>
        
        <DropShadowEffect x:Key="TitleShadow" Color="#000000" Direction="315" ShadowDepth="3" BlurRadius="10" Opacity="0.9"/>
    </Window.Resources>
    <Border Background="{Binding OverlayBackground, Converter={StaticResource HexToBrushConverter}}"
            CornerRadius="20"
            BorderBrush="{Binding OverlayBorderColor, Converter={StaticResource HexToBrushConverter}}"
            BorderThickness="4"
            Padding="15">
        <Grid x:Name="RootElement">
            <StackPanel HorizontalAlignment="Center" MaxWidth="450">
                <!-- Title -->
                <TextBlock Text="Trivia-Tron"
                           FontSize="40"
                           FontWeight="ExtraBold"
                           Foreground="{Binding TitleColor, Converter={StaticResource HexToBrushConverter}}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"
                           Effect="{StaticResource TitleShadow}"/>

                <!-- Active Question Section -->
                <Border Background="{Binding OverlayInnerBackground, Converter={StaticResource HexToBrushConverter}}"
        CornerRadius="15" Padding="15"
        Visibility="{Binding CurrentQuestion, Converter={StaticResource StringToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Active Question"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="{Binding HeaderColor, Converter={StaticResource HexToBrushConverter}}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,5"
                   Effect="{StaticResource TitleShadow}"/>

                        <!-- Timer (big, bold, red when <10s) -->
                        <TextBlock Text="{Binding TimeLeft}"
                   FontSize="28"
                   FontWeight="ExtraBold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,5">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FF4444"/>
                                    <!-- Red when low -->
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TimeLeft}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TimeLeft, Converter={StaticResource TimeLeftSecondsConverter}}" Value="True">
                                            <Setter Property="Foreground" Value="#FF0000"/>
                                            <!-- Bright red <10s -->
                                            <Setter Property="FontSize" Value="28"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Question Text -->
                        <TextBlock Text="{Binding CurrentQuestion}"
                   FontSize="22"
                   Foreground="{Binding TextColor, Converter={StaticResource HexToBrushConverter}}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"/>
                        <TextBlock FontSize="20" 
       Foreground="#AAAAAA" 
       HorizontalAlignment="Center"
       TextWrapping="Wrap"
       TextAlignment="Center" Margin="0,0,0,2">
Commands:
                        </TextBlock>
                        <TextBlock FontSize="16" 
       Foreground="#AAAAAA" 
       HorizontalAlignment="Center"
       TextWrapping="Wrap"
       TextAlignment="Center" Margin="0,0,0,5">
!ik or !answer A/B/C/D • !iq • !leaderboard • !trivia
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Rewards -->
                <TextBlock Text="Rewards"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{Binding GoldColor, Converter={StaticResource HexToBrushConverter}}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"
                           Effect="{StaticResource TitleShadow}"/>
                <TextBlock FontSize="22"
                           Foreground="{Binding AccentColor, Converter={StaticResource HexToBrushConverter}}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"
                           TextWrapping="Wrap"
                           Text="{Binding RewardsText}"/>

                <!-- Timed Leaderboard (20s every 2min) -->
                <Border Background="{Binding OverlayInnerBackground, Converter={StaticResource HexToBrushConverter}}"
                        CornerRadius="15" Padding="20" Margin="0,0,0,15"
                        Visibility="{Binding LeaderboardVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Top 5 Leaderboard"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{Binding HeaderColor, Converter={StaticResource HexToBrushConverter}}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"
                                   Effect="{StaticResource TitleShadow}"/>
                        <ItemsControl ItemsSource="{Binding TopLeaderboard}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="22"
                                               Foreground="{Binding DataContext.TextColor, ElementName=RootElement, Converter={StaticResource HexToBrushConverter}}"
                                               Margin="0,5"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center">
                                        <Run Text="{Binding Rank}"
                                             FontWeight="ExtraBold"
                                             Foreground="{Binding DataContext.TitleColor, ElementName=RootElement, Converter={StaticResource HexToBrushConverter}}"/>
                                        <Run Text=". "/>
                                        <Run Text="{Binding Username}"
                                             FontWeight="Bold"/>
                                        <Run Text=" — "/>
                                        <Run Text="{Binding Iq}"
                                             FontWeight="Bold"
                                             Foreground="{Binding DataContext.GoldColor, ElementName=RootElement, Converter={StaticResource HexToBrushConverter}}"/>
                                        <Run Text=" IQ"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>
                <!-- Highlighted Commands (big when leaderboard hidden) -->
                <Border Background="{Binding OverlayInnerBackground, Converter={StaticResource HexToBrushConverter}}"
                        CornerRadius="15" Padding="15" Margin="0,0,0,10"
                        Visibility="{Binding LeaderboardVisible, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Viewer Commands"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{Binding HeaderColor, Converter={StaticResource HexToBrushConverter}}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"
                                   Effect="{StaticResource TitleShadow}"/>
                        <TextBlock FontSize="20" Foreground="{Binding TextColor, Converter={StaticResource HexToBrushConverter}}" TextWrapping="Wrap" Margin="0,0,0,10">
                            • <Run FontWeight="Bold" Foreground="{Binding AccentColor, Converter={StaticResource HexToBrushConverter}}">!ik or !answer A/B/C/D</Run> — Your answer
                        </TextBlock>
                        <TextBlock FontSize="20" Foreground="{Binding TextColor, Converter={StaticResource HexToBrushConverter}}" TextWrapping="Wrap" Margin="0,0,0,10">
                            • <Run FontWeight="Bold" Foreground="{Binding AccentColor, Converter={StaticResource HexToBrushConverter}}">!iq</Run> — Check your current IQ balance
                        </TextBlock>
                        <TextBlock FontSize="20" Foreground="{Binding TextColor, Converter={StaticResource HexToBrushConverter}}" TextWrapping="Wrap" Margin="0,0,0,10">
                            • <Run FontWeight="Bold" Foreground="{Binding AccentColor, Converter={StaticResource HexToBrushConverter}}">!leaderboard</Run> or <Run FontWeight="Bold" Foreground="{Binding AccentColor, Converter={StaticResource HexToBrushConverter}}">!top</Run> — Show top 5
                        </TextBlock>
                        <TextBlock FontSize="20" Foreground="{Binding TextColor, Converter={StaticResource HexToBrushConverter}}" TextWrapping="Wrap" Margin="0,0,0,0">
                            • <Run FontWeight="Bold" Foreground="{Binding AccentColor, Converter={StaticResource HexToBrushConverter}}">!trivia</Run> — Start a new round
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>

        </Grid>
    </Border>
</Window>
