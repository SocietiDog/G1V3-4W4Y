<Application x:Class="Gw2Giveaway.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Gw2Giveaway"
             xmlns:conv="clr-namespace:Gw2Giveaway.Converters"
             Startup="App_Startup">
    <Application.Resources>
        <conv:BoolToBrushConverter x:Key="BoolToHighlightBrushConverter"
                                   TrueBrush="Gold"
                                   FalseBrush="#FFF3F3EA"/>
        <conv:BoolToThicknessConverter x:Key="BoolToThicknessConverter"
                                       TrueThickness="8"
                                       FalseThickness="1"/>
        <conv:BoolToDoubleConverter x:Key="BoolToBlurConverter"
                                    TrueValue="25"
                                    FalseValue="0"/>
        <conv:RarityToBrushConverter x:Key="RarityToBrushConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:PrizeRarityToBrushConverter x:Key="PrizeRarityToBrushConverter"/>
        <conv:PrizeRarityToTextConverter x:Key="PrizeRarityToTextConverter"/>
        <conv:ActionToVisibilityConverter x:Key="ActionToVisibilityConverter"/>
        <conv:PercentageConverter x:Key="PercentageConverter"/>
        <conv:ColorToHexStringConverter x:Key="ColorToHexConverter"/>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        
        <conv:TimeLeftSecondsConverter x:Key="TimeLeftSecondsConverter"/>
        <conv:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter"/>
        <conv:HexToBrushConverter x:Key="HexToBrushConverter"/>

        <!-- ═══════════════════════════════════════════════
             GW2 App-Wide ContextMenu / MenuItem / Separator
             ═══════════════════════════════════════════════ -->

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#EE1C1008"/>
            <Setter Property="Foreground" Value="#FFF3F3EA"/>
            <Setter Property="BorderBrush" Value="#FFEFDFDF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="16" Opacity="0.7" ShadowDepth="4"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#FFF3F3EA"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Margin="2,1"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}"
                                                  TextBlock.FontSize="{TemplateBinding FontSize}"
                                                  VerticalAlignment="Center"/>
                                <Path x:Name="Arrow" Grid.Column="1"
                                      Data="M0,0 L4,4 L0,8"
                                      Stroke="#FFF3F3EA" StrokeThickness="1.5"
                                      VerticalAlignment="Center" Margin="6,0,2,0"
                                      Visibility="Collapsed"/>
                                <Popup x:Name="PART_Popup"
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       Placement="Right"
                                       HorizontalOffset="-4"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Fade">
                                    <Border Background="#EE1C1008"
                                            BorderBrush="#FFEFDFDF"
                                            BorderThickness="2"
                                            CornerRadius="10"
                                            Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="16" Opacity="0.7" ShadowDepth="4"/>
                                        </Border.Effect>
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FFD700"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#88FFD700"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#66F3F3EA"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#44FFEFDF" Margin="8,3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
